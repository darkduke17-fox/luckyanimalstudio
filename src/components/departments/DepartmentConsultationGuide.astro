---
import type { ConsultationGuide } from '../../data/schema';
interface Props { guide: ConsultationGuide; }
const { guide } = Astro.props;
const anchors = [
  ['guide-about', '老師簡介'],
  ['guide-expertise', '專業專長'],
  ['guide-credentials', '師承資歷'],
  ['guide-services', '服務價目'],
  ['guide-booking', '預約須知'],
];
---

<div class="consultation-guide">
  <header id="guide-about" class="guide-intro">
    <div class="brand-header">
      <p class="section-label">Divination</p>
      <h2>{guide.brandTitle}</h2>
    </div>
    <div class="profile-heading">
      <img class="teacher-portrait" src={guide.profile.imageUrl} alt={`${guide.profile.name}形象照`} width="160" height="160" />
      <div>
        <h3>{guide.profile.name}</h3>
        <p class="profile-tagline">{guide.profile.tagline}</p>
      </div>
    </div>
    <div class="profile-copy">
      {guide.profile.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </header>

  <nav class="guide-anchors" aria-label="麥奇思命理章節導覽">
    {anchors.map(([id, label]) => <a href={`#${id}`}><span aria-hidden="true">✦</span> {label}</a>)}
  </nav>

  <section id="guide-expertise" aria-labelledby="guide-expertise-title">
    <p class="section-label">Expertise</p>
    <h3 id="guide-expertise-title">五大核心專長</h3>
    <div class="expertise-grid">
      {guide.expertise.map((expertise, index) => (
        <article>
          <p class="card-number" aria-hidden="true">0{index + 1} /</p>
          <h4>{expertise.title}</h4>
          <ul>{expertise.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section id="guide-credentials" aria-labelledby="guide-credentials-title">
    <p class="section-label">Credentials &amp; Studies</p>
    <h3 id="guide-credentials-title">師承資歷</h3>
    <div class="credential-group">
      <h4>官方認證</h4>
      <ul class="badge-list certifications">
        {guide.certifications.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="credential-group">
      <h4>個人經歷</h4>
      <ul class="badge-list">
        {guide.experience.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <h4>學習與研習歷程</h4>
    <dl class="studies-grid">
      {guide.studies.map((study) => (
        <div><dt>{study.title}</dt><dd>{study.description}</dd></div>
      ))}
    </dl>
  </section>

  <section id="guide-services" aria-labelledby="divination-services-title">
    <div class="guide-lead-box">
      <h3 class="guide-subtitle"><span aria-hidden="true">✦</span>{guide.title}</h3>
      <p class="guide-description">{guide.introduction}</p>
    </div>
    <h3 id="divination-services-title">{guide.servicesTitle}</h3>
    <div class="service-list">
      {guide.services.map((service) => (
        <article>
          <h4>{service.title}</h4>
          <p>{service.description}</p>
          <ul class="service-details">
            {service.details.map((detail) => <li>{detail}</li>)}
            {service.preparation && (
              <li>
                <strong>{service.preparation.title}</strong>
                <ul>{service.preparation.items.map((item) => <li>{item}</li>)}</ul>
              </li>
            )}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="guide-booking" aria-labelledby="divination-hours-title">
    <h3 id="divination-hours-title">{guide.hoursTitle}</h3>
    <ul class="hours-list">{guide.hours.map((item) => <li>{item}</li>)}</ul>
    <h3 id="divination-booking-title">{guide.bookingTitle}</h3>
    <p>{guide.bookingIntroduction}</p>
    <ul>{guide.bookingRules.map((rule) => <li>{rule}</li>)}</ul>
  </section>
</div>

<style>
  .consultation-guide { padding: 30px 20px 8px; color: var(--color-text-primary); line-height: 1.9; overflow-wrap: anywhere; }
  .guide-intro { padding-bottom: 28px; }
  [id^="guide-"] { scroll-margin-top: 96px; }
  .profile-heading { display: flex; flex-direction: column; align-items: center; gap: 20px; margin-bottom: 24px; text-align: center; }
  .teacher-portrait { flex-shrink: 0; width: 160px; height: 160px; object-fit: cover; border: 2px solid var(--color-metal-accent); border-radius: 50%; padding: 5px; background: var(--color-parchment-base); box-shadow: 0 0 0 4px #b8975333, 0 8px 20px #4d321433; }
  .profile-heading h3 { margin-bottom: 8px; }
  .profile-tagline { margin: 0; color: var(--color-wax-seal); font-weight: 700; }
  .profile-copy { max-width: 40rem; margin-inline: auto; }
  .profile-copy p:last-child { margin-bottom: 0; }
  .guide-anchors { display: flex; gap: 8px; overflow-x: auto; padding: 6px 0; }
  .guide-anchors a { flex-shrink: 0; padding: 8px 12px; border: 1px solid var(--color-metal-accent); border-radius: 5px; background: #fff9e6aa; color: var(--color-wax-seal); font-size: .9rem; font-weight: 700; text-decoration: none; }
  .guide-anchors a:hover { background: #e5d3ac; }
  .guide-anchors a:focus-visible { outline: 3px solid var(--color-wax-seal); outline-offset: -3px; }
  .expertise-grid, .studies-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .card-number { margin: 0 0 6px; color: var(--color-wax-seal); font-size: .8rem; letter-spacing: .15em; }
  .credential-group { margin-bottom: 28px; }
  .badge-list { display: flex; flex-wrap: wrap; gap: 10px; padding: 0; list-style: none; }
  .badge-list li { min-width: 0; max-width: 100%; margin: 0; padding: 10px 14px; background: #fff9e6aa; border: 1px solid #8b6a4777; border-radius: 6px; font-size: .94rem; }
  .certifications li { border-left: 3px solid var(--color-metal-accent); }
  .studies-grid { margin: 0; }
  .studies-grid > div { min-width: 0; padding: 16px; border-left: 2px solid var(--color-metal-accent); background: #fff9e666; }
  dt { color: var(--color-wax-seal); font-weight: 700; }
  dd { margin: 6px 0 0; font-size: .94rem; }
  .hours-list { margin-bottom: 28px; }
  .brand-header { text-align: center; padding-bottom: 22px; margin-bottom: 24px; border-bottom: 1px solid #b8975388; }
  .section-label { margin: 0; color: var(--color-wax-seal); font-size: .65rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  h2 { margin: 7px 0 0; font-size: clamp(1.85rem, 8vw, 2.8rem); font-weight: 900; letter-spacing: .12em; line-height: 1.35; }
  .guide-lead-box { max-width: 40rem; margin: 0 auto 28px; text-align: left; }
  .guide-subtitle { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; padding-left: 10px; border-left: 4px solid var(--color-wax-seal); color: var(--color-wax-seal); font-size: clamp(1.35rem, 5.2vw, 1.65rem); font-weight: 900; letter-spacing: .06em; line-height: 1.4; }
  .guide-subtitle > span { flex-shrink: 0; }
  .guide-description { margin: 0; color: var(--color-text-secondary); font-size: 1rem; font-weight: 400; line-height: 1.85; }
  h3 { margin: 0 0 18px; font-size: clamp(1.2rem, 4.8vw, 1.5rem); line-height: 1.6; }
  h4 { margin: 0 0 12px; color: var(--color-wax-seal); font-size: 1.12rem; line-height: 1.7; }
  p { margin: 0 0 16px; }
  section { padding: 28px 0; border-top: 1px solid #7f624244; }
  .service-list { display: grid; gap: 20px; }
  article { min-width: 0; padding: 20px 16px; background: #fff9e6aa; border: 1px solid #8b6a4777; border-radius: 6px; box-shadow: 0 3px 10px #4d32141a; }
  ul { margin: 0; padding-left: 1.4em; }
  li + li { margin-top: 10px; }
  li > ul { margin-top: 10px; }
  .service-details > li:first-child { font-weight: 700; }
  @media (min-width: 620px) {
    .profile-heading { flex-direction: row; text-align: left; }
    .expertise-grid, .studies-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .expertise-grid > article:last-child { grid-column: 1 / -1; }
    .consultation-guide { padding: 38px 32px 8px; }
    article { padding: 24px; }
  }
</style>
