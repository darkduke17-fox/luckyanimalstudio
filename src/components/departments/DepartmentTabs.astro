---
import type { DepartmentData } from '../../data/schema';
interface Props { departments: DepartmentData[]; }
const { departments } = Astro.props;
---

<nav class="department-tabs" aria-label="部門選擇" data-department-tabs>
  <div role="tablist" aria-label="選擇想了解的部門">
    {departments.map((department, index) => (
      <button type="button" role="tab" id={`tab-${department.id}`} aria-controls={`panel-${department.id}`} aria-selected="false" tabindex={index === 0 ? '0' : '-1'} data-department-id={department.id}>
        <span>{department.name}</span><small>{department.id === 'healing' ? 'Healing' : 'Divination'}</small>
      </button>
    ))}
  </div>
</nav>

<style>
  .department-tabs { position: sticky; z-index: 100; top: 0; padding: 10px 12px; background: #1a1412; border-block: 1px solid #b8975377; box-shadow: 0 8px 18px #100a0788; }
  [role="tablist"] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; max-width: 760px; margin: 0 auto; }
  button { min-width: 0; min-height: 58px; padding: 8px 10px; color: #e7d7ae; background: #382a22; border: 1px solid var(--color-metal-accent); border-radius: 7px; font: 700 .98rem/1.3 var(--font-family); letter-spacing: .08em; cursor: pointer; transition: color 160ms ease, background 160ms ease, transform 160ms ease; }
  button small { display: block; margin-top: 2px; font: 600 .58rem/1.2 var(--font-family); letter-spacing: .18em; opacity: .7; text-transform: uppercase; }
  button:hover { transform: translateY(-1px); }
  button[aria-selected="true"] { color: var(--color-text-primary); background: var(--color-parchment-base); border-color: var(--color-parchment-base); box-shadow: inset 0 0 0 1px #fff9df88; }
  button:focus-visible { outline: 3px solid var(--color-metal-light); outline-offset: 2px; }
  @media (min-width: 768px) {
    .department-tabs { max-width: 680px; margin: 0 auto; border-radius: 8px; }
  }
</style>
